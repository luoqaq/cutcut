# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# All Video Files (Raw camera footage, intermediate cuts, rendered MP4/MOV deliverables)
*.mp4
*.MP4
*.mov
*.MOV
*.m4v
*.avi
*.mkv
*.webm

# Audio Stems & Intermediate Mixes
*.wav
*.WAV

# Generated Visual Frames, Contact Sheets & Covers
projects/**/analysis/*.jpg
projects/**/analysis/*.png
projects/**/qa/qa_frames/
projects/**/qa/qa_portrait_sheet.jpg
projects/**/cover.jpg
projects/**/preview-cover.jpg
docs/**/*.jpg
docs/**/*.png

# Intermediate Render Clips & Logs
projects/*/prepared/clips/
projects/*/prepared/audio/
projects/*/clips/
projects/*/assets/*.wav
projects/*/*.log
projects/*/analysis/frames/
projects/pet-douyin-v01/analysis/
projects/*/jianying_export/native_draft/**/Resources/

# Node & Remotion Studio
studio/node_modules/
studio/.remotion/
studio/out/
studio/public/active/

# Python & Build Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/

# Explicit Whitelist (Keep directory structure & workflow metadata)
!data/**/.gitkeep
!projects/*/prepared/manifest.json
!projects/*/jianying_export/native_draft/**/draft_info.json
!projects/*/jianying_export/native_draft/**/draft_meta_info.json
!projects/*/qa/verification.json
